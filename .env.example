# FORTIROOM environment configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# --- Supabase (PostgreSQL database, auth, storage) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
AVATARS_BUCKET=avatars
STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3

# --- Staff/admin account ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Stripe (penalty payments, use a test key) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# --- ESP32 environment/door controller ---
ESP_ENV_DEVICE_ID=fortiroom-main
ESP_SENSORS_PATH=/api/sensors
ESP_HTTP_TIMEOUT_SEC=6
# Optional overrides (normally discovered automatically via the device registry)
# ESP_BASE_URL=http://192.168.1.60
# ESP_SENSORS_URL=http://192.168.1.60/api/sensors

# --- ESP32-CAM ---
# ESP32_CAM_DEVICE_ID=fortiroom-cam

# --- CompreFace (face verification service) ---
COMPRE_FACE_BASE_URL=http://your-compreface-host:8000/
COMPRE_FACE_API_KEY=your-compreface-verification-api-key
COMPRE_FACE_SIMILARITY_THRESHOLD=0.75
